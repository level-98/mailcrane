<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The secrets file is encrypted with a key that never
     leaves this device, so it is excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/mailcrane_secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/mailcrane_secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
